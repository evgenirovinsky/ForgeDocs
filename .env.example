# App
AUTH_SECRET=replace-with-long-random-string
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Dev auth (credentials). Set AUTH_E2E_BYPASS=true only for Playwright/CI.
AUTH_E2E_BYPASS=false

# Seeded Acme editor email (also used on the login page). Use your MSA email for Azure SSO locally.
DEFAULT_DEV_EMAIL=alice@acme.test
DEFAULT_DEV_NAME=Dev Editor

# Azure AD / Microsoft Entra ID
# Redirect URI to register: http://localhost:3000/api/auth/callback/microsoft-entra-id
# See docs/azure-ad-setup.md
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Personal MSA only: .../consumers/v2.0   |   Org+personal: .../common/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Database
DATABASE_URL=postgresql://forgedocs:forgedocs@localhost:5432/forgedocs?schema=public

# Valkey
VALKEY_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=forgedocs
S3_FORCE_PATH_STYLE=true
