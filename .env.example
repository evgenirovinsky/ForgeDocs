# App
AUTH_SECRET=replace-with-long-random-string
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Dev auth (credentials). Set AUTH_E2E_BYPASS=true only for Playwright/CI.
AUTH_E2E_BYPASS=false

# Azure AD / Microsoft Entra ID (Phase 4 — optional until configured)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Database
DATABASE_URL=postgresql://forgedocs:forgedocs@localhost:5432/forgedocs?schema=public

# Valkey
VALKEY_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=forgedocs
S3_FORCE_PATH_STYLE=true
